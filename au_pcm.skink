// File:    au_pcm.skink
// Purpose: PCM buffer model for skink-audio. A Buffer holds interleaved
//          float64 samples normalized to [-1.0, 1.0] — the canonical
//          in-memory form every other module works with. Conversions
//          to/from 16-bit signed PCM (the WAV wire format) are here.
module au_pcm

import "std/math"
import "std/libc"

// Raw byte accessors for malloc'd buffers — string indexing is bounds-
// checked against strlen, which is meaningless on a buffer that is still
// being written (the first NUL byte would truncate the apparent length).
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)

// Buffer is an interleaved float64 PCM buffer.
pub struct Buffer {
    Rate:     int       // samples per second per channel
    Channels: int       // 1=mono, 2=stereo
    Samples:  []float   // interleaved: frame*Channels + channel
}

// Frames returns the number of sample frames.
pub fn Frames(b: *Buffer) -> int {
    if b.Channels <= 0 {
        return 0
    }
    return len(b.Samples) / b.Channels
}

// DurationSecs returns the buffer length in seconds.
pub fn DurationSecs(b: *Buffer) -> float {
    if b.Rate <= 0 {
        return 0.0
    }
    return float(Frames(b)) / float(b.Rate)
}

// New allocates a zeroed buffer for `frames` sample frames.
pub fn New(rate: int, channels: int, frames: int) -> Buffer {
    var s []float
    for i := 0; i < frames * channels; i = i + 1 {
        s = append(s, 0.0)
    }
    return Buffer{Rate: rate, Channels: channels, Samples: s}
}

// FromF64 wraps an existing sample slice.
pub fn FromF64(rate: int, channels: int, samples: []float) -> Buffer {
    return Buffer{Rate: rate, Channels: channels, Samples: samples}
}

// ToS16 renders the buffer as interleaved little-endian 16-bit PCM
// (malloc'd; caller frees). Returns (bytes, byteLen). Samples are
// clamped to [-1, 1] first.
pub fn ToS16(b: *Buffer) -> (string, int) {
    n := len(b.Samples)
    out := libc.malloc(n * 2)
    for i := 0; i < n; i = i + 1 {
        v := b.Samples[i]
        if v > 1.0 {
            v = 1.0
        }
        if v < -1.0 {
            v = -1.0
        }
        sv := int(v * 32767.0)
        if sv < -32768 {
            sv = -32768
        }
        if sv > 32767 {
            sv = 32767
        }
        u := sv
        if u < 0 {
            u = u + 65536
        }
        Skink_mem_write_byte(out, int64(i * 2), u & 255)
        Skink_mem_write_byte(out, int64(i * 2 + 1), (u >> 8) & 255)
    }
    return out, n * 2
}

// FromS16 decodes interleaved little-endian 16-bit PCM into a Buffer.
pub fn FromS16(rate: int, channels: int, data: string, byteLen: int) -> Buffer {
    n := byteLen / 2
    var s []float
    for i := 0; i < n; i = i + 1 {
        lo := Skink_mem_byte(data, int64(i * 2)) & 255
        hi := Skink_mem_byte(data, int64(i * 2 + 1)) & 255
        v := lo | (hi << 8)
        if v >= 32768 {
            v = v - 65536
        }
        s = append(s, float(v) / 32768.0)
    }
    return Buffer{Rate: rate, Channels: channels, Samples: s}
}

// Mono downmixes any channel count to mono by averaging.
pub fn Mono(b: *Buffer) -> Buffer {
    if b.Channels <= 1 {
        return *b
    }
    fr := Frames(b)
    var s []float
    for f := 0; f < fr; f = f + 1 {
        sum := 0.0
        for ch := 0; ch < b.Channels; ch = ch + 1 {
            sum = sum + b.Samples[f * b.Channels + ch]
        }
        s = append(s, sum / float(b.Channels))
    }
    return Buffer{Rate: b.Rate, Channels: 1, Samples: s}
}

// Stereo duplicates mono to both channels (or returns b unchanged if
// already stereo). Other channel counts are averaged-then-duplicated.
pub fn Stereo(b: *Buffer) -> Buffer {
    if b.Channels == 2 {
        return *b
    }
    m := b
    if b.Channels > 2 {
        mm := Mono(b)
        m = &mm
    }
    fr := Frames(m)
    var s []float
    for f := 0; f < fr; f = f + 1 {
        v := m.Samples[f * m.Channels]
        s = append(s, v)
        s = append(s, v)
    }
    return Buffer{Rate: b.Rate, Channels: 2, Samples: s}
}

// Peak returns the maximum absolute sample value.
pub fn Peak(b: *Buffer) -> float {
    p := 0.0
    for i := 0; i < len(b.Samples); i = i + 1 {
        v := math.Abs(b.Samples[i])
        if v > p {
            p = v
        }
    }
    return p
}

// RMS returns the root-mean-square level.
pub fn RMS(b: *Buffer) -> float {
    if len(b.Samples) == 0 {
        return 0.0
    }
    sum := 0.0
    for i := 0; i < len(b.Samples); i = i + 1 {
        sum = sum + b.Samples[i] * b.Samples[i]
    }
    return math.Sqrt(sum / float(len(b.Samples)))
}
